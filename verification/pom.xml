<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.mikusher</groupId>
  <artifactId>satellite-consumer-verification</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Satellite external consumer verification</name>
  <!-- Deliberately NOT in the parent reactor: verifies consumption of installed artifacts. -->
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <satellite.version>2.0.0-SNAPSHOT</satellite.version>
  </properties>
  <dependencies>
    <dependency><groupId>io.github.mikusher</groupId><artifactId>satellite-data</artifactId><version>${satellite.version}</version></dependency>
    <dependency><groupId>io.github.mikusher</groupId><artifactId>satellite-egress-core</artifactId><version>${satellite.version}</version></dependency>
    <dependency><groupId>io.github.mikusher</groupId><artifactId>satellite-egress-policy</artifactId><version>${satellite.version}</version></dependency>
    <dependency><groupId>io.github.mikusher</groupId><artifactId>satellite-egress-observability</artifactId><version>${satellite.version}</version></dependency>
    <dependency><groupId>io.github.mikusher</groupId><artifactId>satellite-egress-jackson</artifactId><version>${satellite.version}</version></dependency>
    <dependency><groupId>io.github.mikusher</groupId><artifactId>satellite-egress-opentelemetry</artifactId><version>${satellite.version}</version></dependency>
    <dependency><groupId>io.github.mikusher</groupId><artifactId>satellite-data-egress-bridge</artifactId><version>${satellite.version}</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration><release>11</release></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
    </plugins>
  </build>
</project>
