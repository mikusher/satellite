<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.mikusher</groupId>
  <artifactId>satellite-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Satellite</name>
  <description>Typed dynamic data and security-aware application egress for Java.</description>
  <url>https://github.com/mikusher/satellite</url>

  <modules>
    <module>satellite-data</module>
    <module>satellite-legacy-logging</module>
    <module>satellite-egress-core</module>
    <module>satellite-egress-policy</module>
    <module>satellite-egress-observability</module>
    <module>satellite-egress-jackson</module>
    <module>satellite-egress-opentelemetry</module>
    <module>satellite-data-egress-bridge</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <junit.version>4.13.2</junit.version>
    <commons.compress.version>1.28.0</commons.compress.version>
    <jackson.version>2.22.2</jackson.version>
    <json.version>20260814</json.version>
    <lombok.version>1.18.48</lombok.version>
    <commons.io.version>2.22.0</commons.io.version>
    <commons.codec.version>1.22.1</commons.codec.version>
    <commons.lang3.version>3.20.0</commons.lang3.version>
    <guava.version>33.7.1-jre</guava.version>
    <gson.version>2.14.0</gson.version>
    <slf4j.version>2.0.20</slf4j.version>
    <opentelemetry.version>1.66.0</opentelemetry.version>
    <cyclonedx.version>2.9.3</cyclonedx.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx.version}</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>aggregate-sbom</id>
            <phase>verify</phase>
            <goals><goal>makeAggregateBom</goal></goals>
          </execution>
        </executions>
        <configuration>
          <outputFormat>json</outputFormat>
          <schemaVersion>1.6</schemaVersion>
          <includeBomSerialNumber>true</includeBomSerialNumber>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Mikusher Apache Maven Packages</name>
      <url>https://maven.pkg.github.com/mikusher/satellite</url>
    </repository>
  </distributionManagement>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Luis Amilcar Tavares</name>
      <email>mikusher@hotmail.com</email>
      <organization>MikusherBrain</organization>
      <organizationUrl>https://www.mikusher.com/</organizationUrl>
    </developer>
  </developers>
</project>
