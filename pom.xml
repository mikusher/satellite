<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.mikusher</groupId>
  <artifactId>satellite-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Satellite</name>
  <description>Typed dynamic data and security-aware application egress for Java.</description>
  <url>https://github.com/mikusher/satellite</url>

  <modules>
    <module>satellite-parametermap</module>
    <module>satellite-legacy-logging</module>
    <module>satellite-egress-core</module>
    <module>satellite-egress-policy</module>
    <module>satellite-egress-observability</module>
    <module>satellite-egress-jackson</module>
    <module>satellite-egress-opentelemetry</module>
    <module>satellite-parametermap-egress-bridge</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <junit.version>4.13.2</junit.version>
    <commons.compress.version>1.21</commons.compress.version>
    <jackson.version>2.13.3</jackson.version>
    <json.version>20220320</json.version>
    <lombok.version>1.18.24</lombok.version>
    <commons.io.version>2.11.0</commons.io.version>
    <commons.codec.version>1.15</commons.codec.version>
    <commons.lang3.version>3.12.0</commons.lang3.version>
    <guava.version>31.1-android</guava.version>
    <gson.version>2.9.0</gson.version>
    <slf4j.version>1.7.36</slf4j.version>
    <opentelemetry.version>1.66.0</opentelemetry.version>
  </properties>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Mikusher Apache Maven Packages</name>
      <url>https://maven.pkg.github.com/mikusher/satellite</url>
    </repository>
  </distributionManagement>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Luis Amilcar Tavares</name>
      <email>mikusher@hotmail.com</email>
      <organization>MikusherBrain</organization>
      <organizationUrl>https://www.mikusher.com/</organizationUrl>
    </developer>
  </developers>
</project>
